{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python manage.py migrate --noinput",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.env*,.agents/**,venv/**,db.sqlite3,media/**,staticfiles/**,app/tests.py,skills-lock.json}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
